# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Dashboard > Developers > API keys) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Anthropic (for AI listing writer + shopping assistant) ---
# Optional — the app works fine without this, those two AI features just
# return a friendly "not configured" message until you add a key.
ANTHROPIC_API_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
